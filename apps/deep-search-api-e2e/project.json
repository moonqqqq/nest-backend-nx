{
  "name": "deep-search-api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["deep-search-api"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/deep-search-api-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["deep-search-api:build", "deep-search-api:serve"]
    }
  }
}
